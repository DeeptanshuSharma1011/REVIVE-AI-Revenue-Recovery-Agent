# REVIVE Environment Configuration (Phase 0)

# Server-Side Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# Gemini AI (Phase 4 — AI Decision Engine)
# Automatically injected by AI Studio or configured in local .env
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
AI_CONFIDENCE_THRESHOLD="0.70"
RECOVERY_STRATEGY_MODE="deterministic"
PROMPT_VERSION="REVIVE_DECISION_V1"

# Supabase / PostgreSQL Database (Planned for Phase 1+)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
